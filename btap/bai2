#Hiển thị số lớn nhất
def max_num_in_list(list):
    max = list[0]
    for a in list:
        if a > max:
            max = a
    return max

print(max_num_in_list([1, 2, -8, 0]))

#Hiển thị số nhỏ nhất
def smallest_num_in_list(list):
    min = list[0]
    for a in list:
        if a < min:
            min = a
    return min

print(smallest_num_in_list([1, 2, -8, 0]))